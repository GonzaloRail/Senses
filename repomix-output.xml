    onSuccess: (data) => {
      queryClient.invalidateQueries({ queryKey: ["employee-leave", data.id] });
    },
  });
};

export const useUpdateEmployeeLeave = () => {
  return useMutation({
    mutationFn: updateEmployeeLeaveApi,
    onSuccess: (data) => {
      queryClient.invalidateQueries({ queryKey: ["employee-leave", data.id] });
    },
  });
};
